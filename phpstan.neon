parameters:
    # Level 6: checks types, dead code, impossible conditions.
    # Raise to 8 or 'max' once all level-6 issues are resolved.
    level: 6

    paths:
        - beds24-availability-calendar.php

    # Scanned for class declarations but not analyzed for errors.
    # Needed so the main file can reference BAC\Avail_Calendar_Widget.
    scanFiles:
        - widgets/class-avail-calendar-widget.php

    excludePaths:
        - vendor/

    # Elementor classes are not available in the CI environment — suppress
    # "class not found" errors for Elementor types only.
    ignoreErrors:
        - '#Elementor#'

includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

    # Tell PHPStan about WordPress global functions and classes
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
